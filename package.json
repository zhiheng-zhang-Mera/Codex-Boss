{
  "name": "codex-boss",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Local-first desktop control plane for visible, browser-driven AI work.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:seeded": "node scripts/acceptance-seeded-engineering.cjs AB",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package:portable": "node scripts/package-portable.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "security:scan": "node scripts/scan-tracked-secrets.cjs",
    "acceptance:github-machine": "node scripts/acceptance-github-machine-identity.cjs",
    "acceptance:github-machine:live": "electron dist-electron/electron/github/live-acceptance.js",
    "bootstrap:github-machine": "electron dist-electron/electron/github/bootstrap.js",
    "install:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "cross-env": "latest",
    "electron": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
